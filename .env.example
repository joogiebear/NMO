# Where form submissions (nominations, volunteers, sponsors, messages) are sent.
# Set ONE of the following. If neither is set, the site still renders and the
# forms tell people to email instead.

# Option A — email delivery via Resend (https://resend.com, free tier is plenty)
RESEND_API_KEY=
FORMS_TO_EMAIL=info@ninam.org
FORMS_FROM_EMAIL=website@ninam.org

# Option B — post submissions to any webhook (Zapier, Make, a Google Sheet relay)
FORMS_WEBHOOK_URL=

# Public site URL, used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.ninam.org

# Site admin (/admin). Both must be set or the admin stays switched off.
# DATABASE_URL comes from the Railway Postgres service.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
DATABASE_URL=
